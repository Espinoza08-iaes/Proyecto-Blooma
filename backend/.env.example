PORT=5000

# Clave secreta obligatoria para la firma de tokens JWT (Mínimo 32-64 bytes aleatorios)
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=tu_clave_secreta_aqui_generada_criptograficamente

# Credenciales de Supabase (Opcional si se ejecuta en modo local-first offline)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
SUPABASE_ANON_KEY=tu_anon_key_aqui
